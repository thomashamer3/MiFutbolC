				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc-msys2-mingw64" />
				<Option use_console_runner="0" />
				<Compiler>
					<Add option="-fomit-frame-pointer" />
					<Add option="-fexpensive-optimizations" />
					<Add option="-O2" />
					<Add option="-Wextra" />
					<Add option="-Wall" />
					<Add option="-std=c23" />
					<Add option="-m64" />
					<Add option="-Wno-unused-parameter" />
					<Add option="-include" />
					<Add option="compat_port.h" />
					<Add option="-fno-lto" />
					<Add option="-fstack-protector" />
					<Add option="-ffunction-sections" />
					<Add option="-fdata-sections" />
					<Add option="-mtune=native" />
					<Add directory="." />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add option="-static-libgcc" />
					<Add option="-m64" />
					<Add option="-fno-lto" />
					<Add option="C:/msys64/mingw64/lib/libhpdf.dll.a" />
					<Add option="C:/msys64/mingw64/lib/libz.a" />
					<Add option="C:/msys64/mingw64/lib/libpng.a" />
					<Add library="bcrypt" />
					<Add library="comdlg32" />
					<Add library="shell32" />
				</Linker>
			</Target>
